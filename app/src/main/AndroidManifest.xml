<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <attribution android:tag="music_playback" android:label="@string/app_name" />

    <!-- Permisos para leer archivos de audio -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    
    <!-- Permisos de Internet -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Permiso para servicio en primer plano (reproducción en background) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        allowBackup=false a propósito: el backup a la nube de Android tiene un tope de 25 MB
        por app, así que se lleva la BD y las preferencias pero NUNCA el audio descargado.
        Restaurarlo en otro device dejaba dos estados imposibles: canciones marcadas como
        descargadas cuyo archivo no existe (fantasmas que sólo repara el healing del siguiente
        sync), y un delta token de OneDrive válido sobre una biblioteca vacía → el scan
        incremental no reporta nada y la biblioteca se queda EN BLANCO.
        Con targetSdk 35 esto NO desactiva la transferencia device-to-device al cambiar de
        teléfono, que sí copia todo junto (BD + audio) y por eso es consistente.
        Las playlists tienen su propia vía de migración: el backup JSON a OneDrive.
    -->
    <!--
        Predictive back DESACTIVADO (`enableOnBackInvokedCallback="false"`, 18 ago 2026, decisión
        del usuario).

        El atributo se deja ESCRITO en `false` en vez de borrarlo: sin él, el valor efectivo lo
        decide el targetSdk, así que una subida futura podría reactivarlo en silencio. Escrito, la
        decisión se ve y sobrevive.

        Qué cambia: el sistema deja de enseñar la animación de "vas a salir" al arrastrar desde el
        borde, y Navigation Compose deja de recorrer sus transiciones con el dedo
        (`SeekableTransitionState`) — el "atrás" vuelve a ser un evento y no un gesto que se pueda
        soltar a medias.

        Qué NO cambia, y por eso no hay nada más que tocar: los `BackHandler` de la app siguen
        funcionando igual (van por `OnBackPressedDispatcher`, que atiende los dos modos), y las
        CUATRO transiciones del `NavHost` se quedan como están — se declararon para que la pantalla
        de atrás también se mueva, y eso hace falta con gesto o sin él. Lo que el predictive back
        añadía era poder recorrerlas con el dedo, no que existieran.
    -->
    <application
        android:name=".MusicPlayerApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MusicPlayer"
        android:enableOnBackInvokedCallback="false"
        android:localeConfig="@xml/locales_config"
        tools:targetApi="33">

        <property
            android:name="android.content.PROPERTY_ATTRIBUTION_TAG"
            android:value="music_playback" />
        
        <!-- Configuración de WorkManager para Foreground Service -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.MusicPlayer.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Pantalla del informe de fallo (ver CrashReporter).

            `android:process=":crash"` es lo que la hace fiable: la lanza el handler con el proceso
            de la app ya muriendo, y en su propio proceso no arrastra nada de lo que acaba de
            fallar. `MusicPlayerApp.onCreate` se aparta ahí (comprueba el proceso), así que este
            proceso levanta la Activity y nada más.

            Tema del SISTEMA y no el de la app, por el mismo motivo: si el crash estuviera en el
            tema, los recursos de la app o la fuente, la pantalla que informa de él caería también.

            `excludeFromRecents` + `noHistory`: es una pantalla de un solo uso; que se quede en
            recientes solo daría una forma de volver a un informe ya mandado.
        -->
        <activity
            android:name=".ui.screens.CrashReportActivity"
            android:exported="false"
            android:process=":crash"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.DeviceDefault.Light" />

        <!-- Modo Ambient Player (pantalla de reproducción dedicada) -->
        <activity
            android:name=".ui.screens.AmbientPlayerActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.MusicPlayer" />

        <activity
            android:name="com.microsoft.identity.client.BrowserTabActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="msauth"
                    android:host="com.qhana.siku"
                    android:path="/${msalHash}" />
            </intent-filter>
        </activity>

        <!-- Widgets de pantalla de inicio (Glance) -->
        <receiver
            android:name=".widget.PlayerWidgetReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_player_info" />
        </receiver>

        <receiver
            android:name=".widget.QueueWidgetReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_queue_info" />
        </receiver>

        <!-- Servicio de reproducción de música -->
        <service
            android:name=".service.MusicPlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback"
            android:stopWithTask="false">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!--
            Compartir la canción en curso: los audios descargados viven en el almacenamiento
            privado de la app y sin provider no hay forma de pasarle el archivo a otra app.
            El alcance está acotado en res/xml/file_paths.xml a files/music.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Disable default WorkManager initializer for Hilt on-demand initialization -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

    </application>

</manifest>
